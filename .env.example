PORT=5000
DATABASE_URL=postgresql://postgres:@localhost:5432/skillbridge
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Plusieurs origines separees par virgule.
# 5173 = site public, 5174 = back-office d administration.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Gmail SMTP — utilise un mot de passe d'application Google (16 caracteres, pas le mot de passe du compte)
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Mettre a true pour exiger la verification email avant connexion (defaut : false)
REQUIRE_EMAIL_VERIFICATION=false

# Niveau de log : fatal, error, warn, info, debug, trace (defaut : info en production)
LOG_LEVEL=info

# Hotes autorises a servir les pieces jointes du chat, separes par virgule.
# Vide = n'importe quel hote https, acceptable seulement tant qu'aucun stockage
# de fichiers n'est en place.
ALLOWED_FILE_HOSTS=

# --- Docker Compose uniquement ---
# Mot de passe du conteneur PostgreSQL. Obligatoire : compose refuse de demarrer
# sans lui, pour qu'aucun mot de passe par defaut ne se retrouve en production.
POSTGRES_PASSWORD=

# Suivi des erreurs (optionnel). Vide = desactive, aucune autre difference.
# Renseigner le DSN fourni par Sentry pour activer les alertes.
SENTRY_DSN=
